# Public, non-secret configuration for the threshold aggregator/relayer.
# VRF_RPC_URLS is a root-only systemd credential because provider URLs commonly contain tokens.
VRF_COORDINATOR=0x0000000000000000000000000000000000000000
VRF_FROM_BLOCK=0
VRF_THRESHOLD_MANIFEST=/etc/proof-vrf/threshold-group.json
