[Unit]
Description=Robinhood proof VRF testnet operator
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
Type=simple
User=proof-vrf
Group=proof-vrf
WorkingDirectory=/opt/proof-vrf/current
EnvironmentFile=/etc/proof-vrf/operator.conf
LoadCredential=tx-private-key:/etc/proof-vrf/credentials/tx-private-key
LoadCredential=database-url:/etc/proof-vrf/credentials/database-url
LoadCredential=prover-bearer-token:/etc/proof-vrf/credentials/prover-bearer-token
LoadCredential=rpc-urls:/etc/proof-vrf/credentials/rpc-urls
ExecStart=/usr/bin/env VRF_TX_PRIVATE_KEY_FILE=${CREDENTIALS_DIRECTORY}/tx-private-key VRF_DATABASE_URL_FILE=${CREDENTIALS_DIRECTORY}/database-url VRF_PROVER_BEARER_TOKEN_FILE=${CREDENTIALS_DIRECTORY}/prover-bearer-token VRF_RPC_URLS_FILE=${CREDENTIALS_DIRECTORY}/rpc-urls /usr/bin/node /opt/proof-vrf/current/vrf/operator/cli.mjs run-v2 --readiness true --expected-chain-id 46630 --minimum-rpc-count 2 --minimum-relayer-balance-eth 0.002 --prover-url ${VRF_PROVER_URL} --proof-key-hash ${VRF_PROOF_KEY_HASH} --prover-client-key /etc/proof-vrf/tls/prover-client.key --prover-client-cert /etc/proof-vrf/tls/prover-client.crt --prover-ca /etc/proof-vrf/tls/prover-ca.crt --coordinator ${VRF_COORDINATOR} --from-block ${VRF_FROM_BLOCK} --health-file /var/lib/proof-vrf/health.json --event-confirmations 2 --reorg-lookback 32 --archive-after-blocks 128 --replacement-ms 45000 --replacement-attempts 3 --scan-lease-seconds 60 --request-lease-seconds 360 --work-limit 25
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=proof-vrf
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadOnlyPaths=/opt/proof-vrf
ReadWritePaths=/var/lib/proof-vrf
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
